<!DOCTYPE html>
<html>
  <head>
    <title>PPT Automation</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="container">
      <h1>PPT Automation</h1>
      <form action="/presentation/update" method="POST">
        <label> Select Section </label>
        <select name="section">

          <option value="intro">Introduction</option>
          <option value="brand">Brand Communication</option>
          <option value="videos">Videos & Animation</option>
          <option value="personalized">Personalized Video</option>
          <option value="rxpl">RxPL</option>
          <option value="websites">Websites</option>
          <option value="qr">QR Generation</option>
          <option value="games">Games</option>

        </select>
        <br /><br />
        <button>Update PPT</button>
      </form>
    </div>
  </body>
</html>
